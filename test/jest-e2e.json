{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/support/global-setup.ts",
  "globalTeardown": "<rootDir>/test/support/global-teardown.ts",
  "testTimeout": 60000,
  "openHandlesTimeout": 10000,
  "maxWorkers": 1,
  "forceExit": false
}
