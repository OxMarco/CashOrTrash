{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pinned, not inferred. Without it TypeScript derives the root from
    // whichever files it happens to find: on a developer's machine that is
    // `src` *and* `scripts/emit-openapi.ts`, so the entrypoint lands at
    // `dist/src/main.js`, while the Dockerfile's builder stage copies only
    // `src` and gets `dist/main.js`. Two layouts for one build, and every
    // path that names the entrypoint was right in exactly one of them.
    //
    // `scripts/emit-openapi.ts` has to keep compiling alongside `src` — it
    // must run from `dist/scripts` against the built output, because the
    // Swagger CLI plugin that infers DTO schemas runs during `nest build`
    // (see the comment at the top of that file). So the fix is to fix the
    // root, not to narrow what is compiled.
    "rootDir": "."
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
