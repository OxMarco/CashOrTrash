# --- runtime ---
NODE_ENV=development
PORT=3000
API_PREFIX=v1
LOG_LEVEL=debug

# --- postgres ---
# Nothing to set: host and credentials are fixed in
# docker-compose.local.yml / docker-compose.prod.yml, where the database lives.
# The app defaults to localhost:5432 cashortrash/cashortrash for `make dev-deps`
# + `npm run start:dev`; override DATABASE_HOST here only if yours is elsewhere.

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- auth ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_TTL=15m

# At least 32 random characters. Production uses this to make slider layouts
# reproducible for fair play without making the answer enumerable by clients.
SLIDER_SEED_SECRET=replace-with-at-least-32-random-characters

# The same idea applied to *which* items a day deals. The only thing in the
# unkeyed scope is a calendar date, so without a secret anyone can compute every
# future daily challenge offline and look the five objects up in advance. Its
# own value, not a copy of the slider's: that one is exposed by every finished
# round, and this one is exposed by nothing.
DAILY_SEED_SECRET=replace-with-at-least-32-random-characters

# --- keeping answers out of the wrong rounds ---
# Finishing a round reveals the true price, so quick and head-to-head rounds are
# where prices are learned and the daily is where they are tested. These two
# stop the first from answering the second.
#
# How far ahead dailies are generated — and therefore how long their items are
# held out of every other mode.
DAILY_PREGENERATE_DAYS=1
# How long an item stays out of one player's rounds after they have been dealt
# it. 0 lets items repeat immediately.
ITEM_COOLDOWN_DAYS=30

# --- budgets ---
# New accounts cannot reach the leaderboard for this long, which is what makes
# the two budgets below worth having.
LEADERBOARD_MIN_ACCOUNT_AGE_HOURS=0
# How fast one account can be dealt new items (five per round, five answers),
# counted across quick *and* head-to-head — both deal and both reveal — and how
# many accounts one address can register in a day. 0 = off.
QUICK_SESSIONS_PER_HOUR=30
ACCOUNTS_PER_IP_PER_DAY=50
# How long the address an account registered from is kept before a nightly job
# clears it. This network identifier is useful only while an abuse investigation
# might still ask about it. 0 keeps it for the account's life.
REGISTRATION_IP_RETENTION_DAYS=30

# --- admin portal ---
# The catalogue is filled at /admin: sign in, create categories, drag in
# photographs. Naming a file `<description>_<price in USD>.<ext>` pre-fills the
# name and price on the upload form; anything else is typed in.
#
# The password is stored as an scrypt hash, never as itself:
#
#   printf '%s' 'the password' | npm run admin:hash
#
# Empty disables the portal — every login answers 503 and no token can be
# minted. Production refuses to boot without both values.
ADMIN_PASSWORD_HASH=
# Independent of JWT_ACCESS_SECRET, and at least 32 characters. Sharing the
# player secret would let any device's token be replayed against the catalogue
# editor with one claim changed.
ADMIN_JWT_SECRET=
# How long a portal sign-in lasts.
ADMIN_SESSION_TTL=2h

# --- gameplay ---
ROUNDS_PER_SESSION=5
# seconds a player has to bet, timed from when the server dealt the round and
# checked against the server's clock when the bet lands (0 = no limit)
ROUND_SECONDS=10
# slack on that deadline, so a bet placed in time is not lost to its own flight
ROUND_GRACE_MS=1500
# minimum seconds a player must spend on a round before a bet is accepted. Free
# to a human, expensive to a script, which has nothing but speed (0 = off)
MIN_ROUND_SECONDS=1
# how long an unaccepted head-to-head invite stays joinable. 0 means it never
# expires, which is a choice rather than a default — a code shared once stays
# redeemable for as long as it is readable
MATCH_INVITE_TTL_DAYS=7

# --- currency ---
# The catalogue is priced in US dollars and nothing else. These rates turn one
# dollar into the currency a player chose, and turn their bet back into dollars
# to be scored. Fetched live from the provider below — the default is the ECB's
# daily reference rates via Frankfurter, which needs no key.
CURRENCY_API_URL=https://api.frankfurter.dev/v1/latest
CURRENCY_REFRESH_SECONDS=3600
CURRENCY_TIMEOUT_MS=5000

# --- throttling ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Development logs push attempts. Production requires the real Expo sender.
PUSH_PROVIDER=logging
PUSH_TIMEOUT_MS=10000

# --- client ---
DEEP_LINK_BASE=cashortrash://match
# The public https origin this deployment answers on, e.g. https://cashortrash.fun
# Appended to a shared result so the grid has somewhere to point. The bare
# origin, not a /match path: that path is claimed by the app in both association
# files, and a shared result is read mostly by people who do not have the app.
# Left empty, the share carries no link. Production derives this from DOMAIN in
# docker-compose.prod.yml, so there is nothing extra to set there.
PUBLIC_ORIGIN=
SWAGGER_ENABLED=true
# Browser origins for the app's web target, comma-separated. Ignored in
# development (any origin is allowed); empty in production means no browser
# clients. Native builds never preflight, so this never affects them.
CORS_ORIGINS=

# --- media ---
# Where washed item photographs are written and served from. In production this
# is the `mediadata` volume, mounted read-write: the app both produces the
# derivatives and serves them.
#
# It is paired with every database backup. `db-backup` tars it separately —
# restoring a pg_dump without the media leaves every item pointing at a file
# that no longer exists.
MEDIA_ROOT=/var/lib/cashortrash/media
# Empty means the API serves the bytes itself and `photoUrl` stays a
# root-relative path. Set to a CDN origin (no trailing slash) to move the
# traffic off the app without rewriting a single stored row.
MEDIA_PUBLIC_BASE=

# --- catalogue copywriting ---
# Shortly after an upload, the model rewrites the item's title and the
# description shown under its photograph, in English and then in es/pt/it.
# Required in production: without it uploads still work and the catalogue still
# plays, but every item keeps the plain text typed into the portal, which is not
# what should reach a store.
#
# The model is never shown an item's price — that is what stops it writing
# "a bargain at this price" and handing the player the answer.
OPENAI_API_KEY=
# The task is short and tightly specified, so a mid-tier model usually reads as
# well as a larger one. Raise it if the lines come back generic.
OPENAI_MODEL=gpt-5.4
# How long one request may take, and how many times it may be retried. Bounded
# because the copy pass holds a Postgres advisory lock for its whole run, so a
# provider that hangs stops the other replica picking the work up rather than
# merely delaying some prose. The SDK's own defaults are ten minutes and two.
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# --- deployment (docker-compose.prod.yml only) ---
# Read by compose, not by the app. Everything with a sensible default lives in
# the compose file; only what is specific to this host is here.
#
# Apex hostname. Its A record (and www's, for the www -> apex redirect) must
# point at this host before the first `make up`, or the Let's Encrypt HTTP-01
# challenge cannot validate.
DOMAIN=cashortrash.example.com
# Shown on the privacy, deletion and support pages.
SUPPORT_EMAIL=support@example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=ops@example.com
# Encrypted off-site backups. Example for S3-compatible storage:
#   s3:https://s3.example.com/cashortrash-backups
# The repository must be outside this production host. Generate the password
# once, store it in the secret manager, and keep a recovery copy elsewhere.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Optional temporary AWS credential.
AWS_SESSION_TOKEN=
# Alternatively use Restic's native Backblaze B2 backend.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Universal/App Link association — fill in once the app is in the stores.
# APPLE_APP_ID is Team ID + bundle id (e.g. ABCDE12345.fun.cashortrash.app);
# the fingerprint is the SHA-256 of the Play signing certificate (Play Console
# -> Setup -> App signing). Empty: the .well-known files 404 and a shared
# /match link opens in the browser instead of the app.
APPLE_APP_ID=
ANDROID_SHA256_CERT_FINGERPRINT=
