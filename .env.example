# --- runtime ---
NODE_ENV=development
PORT=3000
API_PREFIX=v1
LOG_LEVEL=debug

# --- postgres ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cashortrash
DATABASE_PASSWORD=cashortrash
DATABASE_NAME=cashortrash
DATABASE_SSL=false
# The schema follows the entities in development, so a new column needs no
# migration. Forced off when NODE_ENV=production, which stays on migrations.
DATABASE_SYNCHRONIZE=true

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- auth ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_REFRESH_TTL=60d

# --- catalogue import ---
# The catalogue is a directory tree: one folder per category, one image per
# item, named `<description>_<price in USD>.<ext>`, plus an `icon.txt` naming
# the category's glyph. The job runs on boot, recognises images it has already
# imported by content hash, and only does work for new files.
#
# Where that tree lives. Unset resolves next to the compiled output, which is
# where the Docker image puts it — override only for an unusual layout.
ITEMS_ROOT=
# Whether a deploy imports the tree it shipped with. Turn this off to boot a
# replica that serves the catalogue without writing to it.
IMPORT_ON_BOOT=true

# --- gameplay ---
ROUNDS_PER_SESSION=5
# seconds a player has to bet, timed from when the server dealt the round and
# checked against the server's clock when the bet lands (0 = no limit)
ROUND_SECONDS=10
# slack on that deadline, so a bet placed in time is not lost to its own flight
ROUND_GRACE_MS=1500
# minimum seconds a player must spend on a round before a bet is accepted (0 = off)
MIN_ROUND_SECONDS=0

# --- currency ---
# The catalogue is priced in US dollars and nothing else. These rates turn one
# dollar into the currency a player chose, and turn their bet back into dollars
# to be scored. Fetched live from the provider below — the default is the ECB's
# daily reference rates via Frankfurter, which needs no key.
CURRENCY_API_URL=https://api.frankfurter.dev/v1/latest
CURRENCY_REFRESH_SECONDS=3600
CURRENCY_TIMEOUT_MS=5000
# Not rates — the floor under them. Used only until the first live fetch lands,
# and again if the provider is unreachable with nothing cached.
CURRENCY_FALLBACK_RATE_EUR=0.92
CURRENCY_FALLBACK_RATE_GBP=0.79

# --- throttling ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- client ---
DEEP_LINK_BASE=cashortrash://match
SWAGGER_ENABLED=true
# Browser origins for the app's web target, comma-separated. Ignored in
# development (any origin is allowed); empty in production means no browser
# clients. Native builds never preflight, so this never affects them.
CORS_ORIGINS=

# --- media ---
# Where washed item photographs are written and served from. In production this
# is the `mediadata` volume, mounted read-write: the app both produces the
# derivatives and serves them.
#
# It is NOT covered by the database backup. `db-backup` tars it separately —
# restoring a pg_dump without the media leaves every item pointing at a file
# that no longer exists.
MEDIA_ROOT=/var/lib/cashortrash/media
# Empty means the API serves the bytes itself and `photoUrl` stays a
# root-relative path. Set to a CDN origin (no trailing slash) to move the
# traffic off the app without rewriting a single stored row.
MEDIA_PUBLIC_BASE=

# --- catalogue copywriting ---
# The import rewrites each item's title and the description shown under its
# photograph. Required whenever IMPORT_ON_BOOT is true: without it the boot
# fails rather than quietly importing a catalogue of raw filenames.
#
# The model is never shown an item's price — that is what stops it writing
# "a bargain at this price" and handing the player the answer.
OPENAI_API_KEY=
# The task is short and tightly specified, so a mid-tier model usually reads as
# well as a larger one. Raise it if the lines come back generic.
OPENAI_MODEL=gpt-5.4

# --- deployment (docker-compose.prod.yaml only) ---
# Ignored by the app itself; read by compose. DATABASE_HOST/PORT and
# REDIS_HOST/PORT above are overridden with compose service names in
# production, so their values here do not matter on the server.
#
# The apex hostname. A DNS A record for it — and for www, if you want the
# www -> apex redirect — must point at this host before the first `make up`,
# or the Let's Encrypt HTTP-01 challenge cannot validate.
DOMAIN=cashortrash.example.com
# Where Let's Encrypt sends expiry warnings. Must be a real address.
ACME_EMAIL=ops@example.com
# Daily pg_dump retention, in days.
BACKUP_KEEP_DAYS=14
# Weekly item-photo tar retention, in weeks. The media store is
# content-addressed and only grows, so a daily copy of the same immutable bytes
# would buy nothing.
MEDIA_KEEP_WEEKS=4
